# ── Deployer ──────────────────────────────────────────────────────────────────
# 32-byte hex private key. NEVER commit the filled-in .env, and never paste a
# real key into THIS file either — it is tracked by git.
# If left empty, hardhat.config.ts falls back to the key file below.
DEPLOYER_PRIVATE_KEY=

# Optional: path (relative to robinpump-staking/) of a file holding the key.
# Defaults to ../pk.txt, which .gitignore excludes.
DEPLOYER_KEY_FILE=../pk.txt

# ── Network ───────────────────────────────────────────────────────────────────
# Public endpoint. If you use a keyed provider (Alchemy/Infura/etc.), put that
# URL in .env only — the API key must never be committed.
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# ── Contracts ─────────────────────────────────────────────────────────────────
NFT_CONTRACT_ADDRESS=0xbd00ce673b84be8022af8be0039c7a5af69724a9
REWARD_TOKEN_ADDRESS=0xb5Ea549fc8Ad1665aCda9051e91aDe6A371B7BFf

# Filled in by scripts/deploy.ts after a successful deployment.
STAKING_CONTRACT_ADDRESS=

# ── Explorer ──────────────────────────────────────────────────────────────────
# Blockscout accepts any non-empty string.
BLOCKSCOUT_API_KEY=

# ── Ownership ─────────────────────────────────────────────────────────────────
# Contract owner after deployment. Leave empty to use the deployer address.
OWNER_ADDRESS=

# ── Funding ───────────────────────────────────────────────────────────────────
# Human-readable $ROBINPUMP amount for `npm run fund:rewards`, e.g. 5000000
FUND_AMOUNT=
