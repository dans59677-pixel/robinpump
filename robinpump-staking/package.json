{
  "name": "robinpump-staking",
  "version": "1.0.0",
  "private": true,
  "description": "RobinPump Green Flock NFT staking — production contracts, tests and deployment tooling for Robinhood Chain (4663)",
  "license": "MIT",
  "scripts": {
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "abi": "ts-node --files scripts/export-abi.ts",
    "preflight": "hardhat run scripts/preflight.ts --network robinhood",
    "estimate": "hardhat run scripts/estimate-deploy.ts --network robinhood",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network robinhood",
    "configure:tiers": "hardhat run scripts/configure-tiers.ts --network robinhood",
    "configure:tiers:csv": "hardhat run scripts/configure-tiers-from-csv.ts --network robinhood",
    "auto:tiers": "hardhat run scripts/auto-configure-tiers.ts --network robinhood",
    "fund:rewards": "hardhat run scripts/fund-rewards.ts --network robinhood",
    "lock:rarity": "hardhat run scripts/lock-rarity.ts --network robinhood",
    "verify:contract": "hardhat run scripts/verify.ts --network robinhood",
    "status": "hardhat run scripts/status.ts --network robinhood"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "@nomicfoundation/hardhat-ethers": "3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "1.0.12",
    "@nomicfoundation/hardhat-verify": "2.0.12",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.2",
    "chai": "4.5.0",
    "hardhat": "2.22.17",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.1.0",
    "dotenv": "16.4.7",
    "ethers": "6.13.4"
  }
}
